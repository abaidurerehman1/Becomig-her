[Unit]
Description=Becoming HER waitlist API
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=exec
User=becomingher
Group=becomingher
WorkingDirectory=/opt/becoming-her/current/server
# Written by the deploy job from GitHub Secrets (DATABASE_URL, ADMIN_TOKEN, CORS_ORIGINS)
EnvironmentFile=/opt/becoming-her/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/becoming-her/venv/bin/uvicorn main:app --host 127.0.0.1 --port 9161 --workers 2 --proxy-headers
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
